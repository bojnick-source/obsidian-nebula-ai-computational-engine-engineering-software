<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FORGE Engineering Report — {{ project }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
    onload="renderMathInElement(document.body);"></script>
  <style>
    body { font-family: 'Georgia', serif; max-width: 960px; margin: 40px auto; color: #1a1a1a; }
    h1, h2, h3 { font-family: 'Arial', sans-serif; }
    h1 { border-bottom: 2px solid #333; padding-bottom: 8px; }
    h2 { border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-top: 40px; }
    .meta-table { border-collapse: collapse; width: 100%; }
    .meta-table td, .meta-table th { border: 1px solid #ddd; padding: 6px 12px; }
    .meta-table th { background: #f5f5f5; }
    .gate-pass { color: #2a7f2a; font-weight: bold; }
    .gate-fail { color: #c0392b; font-weight: bold; }
    .finding-block { border-left: 4px solid #3498db; padding: 8px 16px; margin: 16px 0; background: #f8fbff; }
    .assumption-list { background: #fff8e1; border-left: 4px solid #f39c12; padding: 8px 16px; }
    .falsifiability { font-style: italic; color: #555; }
    .traceability { font-size: 0.85em; color: #777; }
    .calc-chain { background: #f9f9f9; border: 1px solid #e0e0e0; padding: 12px; margin: 8px 0; border-radius: 4px; }
    .degraded-warning { background: #fff3cd; border: 1px solid #ffc107; padding: 8px 16px; border-radius: 4px; }
    .cost-summary { background: #f0f4ff; padding: 12px; border-radius: 4px; }
    details summary { cursor: pointer; font-weight: bold; color: #2c3e50; }
    table { border-collapse: collapse; width: 100%; margin: 16px 0; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background: #f5f5f5; }
    @media print {
      body { max-width: 100%; margin: 0; }
      details { display: block; }
      details[open] summary::after { content: ""; }
    }
  </style>
</head>
<body>

<!-- ═══════════════════════════════════════════════════════ COVER -->
<h1>FORGE Engineering Report</h1>

<table class="meta-table">
  <tr><th>Project</th><td>{{ project }}</td></tr>
  <tr><th>Task</th><td>{{ task }}</td></tr>
  <tr><th>Run ID</th><td><code>{{ run_id }}</code></td></tr>
  <tr><th>Trace ID</th><td><code>{{ trace_id }}</code></td></tr>
  <tr><th>Started</th><td>{{ started_at }}</td></tr>
  <tr><th>Completed</th><td>{{ completed_at or "—" }}</td></tr>
  <tr><th>Status</th><td class="{{ 'gate-pass' if success else 'gate-fail' }}">{{ "PASS" if success else "FAIL" }}</td></tr>
</table>

{% if degraded_modes %}
<div class="degraded-warning">
  <strong>Degraded Modes Active:</strong> {{ degraded_modes | join(", ") }}
</div>
{% endif %}

<!-- ═══════════════════════════════════════════════════════ 1. EXECUTIVE SUMMARY -->
<h2>1. Executive Summary</h2>
<p>This report documents a FORGE automated engineering analysis run. The pipeline executed
{{ phases | length }} phases and dispatched {{ findings | length }} agent analysis tasks.</p>

<div class="cost-summary">
  <strong>Run Cost:</strong> ${{ "%.4f"|format(total_cost_usd) }} &nbsp;|&nbsp;
  <strong>Tokens In:</strong> {{ total_tokens_in:,}} &nbsp;|&nbsp;
  <strong>Tokens Out:</strong> {{ total_tokens_out:,}}
</div>

<!-- ═══════════════════════════════════════════════════════ 2. VERIFICATION GATES -->
<h2>2. Verification Gate Results</h2>

{% if gates %}
<table>
  <thead>
    <tr><th>Gate</th><th>Result</th><th>Details</th></tr>
  </thead>
  <tbody>
  {% for g in gates %}
    <tr>
      <td>{{ g.gate }}</td>
      <td class="{{ 'gate-pass' if g.passed else 'gate-fail' }}">{{ "PASS" if g.passed else "FAIL" }}</td>
      <td>
        {% for k, v in g.details.items() %}
          {% if k not in ['gate', 'passed'] %}{{ k }}: {{ v }}{% if not loop.last %}, {% endif %}{% endif %}
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p><em>No verification gate data recorded.</em></p>
{% endif %}

<!-- ═══════════════════════════════════════════════════════ 3. AGENT FINDINGS -->
<h2>3. Agent Findings</h2>

{% for f in findings %}
<div class="finding-block">
  <strong>{{ f.agent_id }}</strong> (phase: {{ f.phase }}) — confidence: {{ "%.2f"|format(f.confidence) }}

  {% if f.findings %}
  <ul>
    {% for item in f.findings %}<li>{{ item }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if f.assumptions %}
  <div class="assumption-list">
    <strong>Assumptions:</strong>
    <ul>{% for a in f.assumptions %}<li>{{ a }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  {% if f.what_would_falsify %}
  <p class="falsifiability">What would falsify this: {{ f.what_would_falsify }}</p>
  {% endif %}
</div>
{% else %}
<p><em>No findings recorded.</em></p>
{% endfor %}

<!-- ═══════════════════════════════════════════════════════ 4. TOOL RESULTS -->
<h2>4. Tool Invocation Results</h2>

{% if tool_results %}
<table>
  <thead>
    <tr><th>Tool</th><th>Invocation ID</th><th>Status</th><th>Duration (s)</th><th>Key Outputs</th></tr>
  </thead>
  <tbody>
  {% for t in tool_results %}
    <tr>
      <td>{{ t.tool_id }}</td>
      <td><code style="font-size:0.8em">{{ t.invocation_id[:16] }}…</code></td>
      <td class="{{ 'gate-pass' if t.success else 'gate-fail' }}">{{ "OK" if t.success else "FAIL" }}</td>
      <td>{{ "%.2f"|format(t.duration_s) }}</td>
      <td>
        {% for k, v in t.outputs.items() %}
          {{ k }}: <strong>{{ v }}</strong>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p><em>No tool results recorded.</em></p>
{% endif %}

<!-- ═══════════════════════════════════════════════════════ 5. ADVERSARIAL DEBATE -->
{% if debate_rounds %}
<h2>5. Adversarial Debate Summary</h2>
<p>{{ debate_rounds | length }} debate round(s) conducted.</p>
{% for r in debate_rounds %}
<details>
  <summary>Round {{ loop.index }}: {{ r.get('phase', '') }}</summary>
  <pre>{{ r | tojson(indent=2) }}</pre>
</details>
{% endfor %}
{% endif %}

<!-- ═══════════════════════════════════════════════════════ 6. PIPELINE TRACE -->
<h2>{{ "6" if debate_rounds else "5" }}. Pipeline Trace</h2>

<details open>
  <summary>Phases Completed ({{ phases | length }})</summary>
  <ol>{% for p in phases %}<li>{{ p }}</li>{% endfor %}</ol>
</details>

<details>
  <summary>Vault Notes Written ({{ vault_notes | length }})</summary>
  <ul>{% for n in vault_notes %}<li><code>{{ n }}</code></li>{% endfor %}</ul>
</details>

<details>
  <summary>Traceability</summary>
  <p class="traceability">
    Trace ID: <code>{{ trace_id }}</code><br>
    Run ID: <code>{{ run_id }}</code><br>
    All findings, tool results, and verification gate outcomes are indexed under this trace ID
    in the FORGE vault and DuckDB event log.
  </p>
</details>

<!-- ═══════════════════════════════════════════════════════ FOOTER -->
<hr>
<p style="font-size:0.8em; color:#999;">
  Generated by FORGE v0.1 · Report is auto-generated and must be reviewed by a licensed engineer
  before use in structural decisions. · <code>{{ trace_id }}</code>
</p>

</body>
</html>
